# ---------------------------------------------------------------------
# MeetingMind AI -- environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual `.env` file to version control.
# ---------------------------------------------------------------------

# Groq (LLM) -- required for meeting analysis
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase (Database + Storage) -- required for history/persistence
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_KEY=

# Google OAuth -- optional (Guest Mode works without it)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URI=http://localhost:8501
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_USERINFO_URI=https://www.googleapis.com/oauth2/v2/userinfo

# Faster Whisper (local, free, CPU-only speech-to-text)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
